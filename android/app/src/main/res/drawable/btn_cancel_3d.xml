<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="2dp">
                <shape>
                    <solid android:color="#E2E8F0" />
                    <corners android:radius="14dp" />
                    <stroke android:width="1.5dp" android:color="#CBD5E1" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Normal state with 3D bottom bevel -->
    <item>
        <layer-list>
            <!-- Bottom bevel 3D shadow layer -->
            <item>
                <shape>
                    <solid android:color="#CBD5E1" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <!-- Main elevated surface -->
            <item android:bottom="3.5dp">
                <shape>
                    <gradient
                        android:startColor="#FFFFFF"
                        android:endColor="#F1F5F9"
                        android:angle="270" />
                    <corners android:radius="14dp" />
                    <stroke android:width="1.5dp" android:color="#E2E8F0" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
