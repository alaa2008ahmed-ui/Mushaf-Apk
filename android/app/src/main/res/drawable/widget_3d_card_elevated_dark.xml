<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bottom Shadow -->
    <item android:top="2dp" android:left="1dp" android:right="1dp" android:bottom="4dp">
        <shape>
            <solid android:color="#77000000" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <!-- Base Card -->
    <item android:bottom="2dp">
        <shape>
            <solid android:color="#1E232A" />
            <corners android:radius="18dp" />
            <stroke android:width="1.5dp" android:color="#3A4454" />
        </shape>
    </item>
</layer-list>
