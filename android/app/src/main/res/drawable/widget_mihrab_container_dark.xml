<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Elevation Shadow -->
    <item android:top="2dp" android:left="1dp" android:right="1dp" android:bottom="4dp">
        <shape>
            <solid android:color="#99000000" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <!-- Container Body -->
    <item android:bottom="2.5dp">
        <shape>
            <gradient
                android:angle="135"
                android:startColor="#11161D"
                android:endColor="#0B0F14" />
            <corners android:radius="22dp" />
            <stroke android:width="2dp" android:color="#F59E0B" />
        </shape>
    </item>
</layer-list>
