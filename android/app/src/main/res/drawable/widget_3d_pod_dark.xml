<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Drop Shadow -->
    <item android:top="1dp" android:left="1dp" android:right="1dp" android:bottom="2.5dp">
        <shape>
            <solid android:color="#66000000" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <!-- Card Face -->
    <item android:bottom="1.5dp">
        <shape>
            <solid android:color="#242B35" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#3A4659" />
        </shape>
    </item>
</layer-list>
