<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Elevated Drop Shadow -->
    <item android:top="2dp" android:left="1dp" android:right="1dp" android:bottom="3dp">
        <shape>
            <solid android:color="#40F59E0B" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <!-- Card Face -->
    <item android:bottom="2dp">
        <shape>
            <gradient
                android:angle="135"
                android:startColor="#B45309"
                android:endColor="#C86400" />
            <corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="#F59E0B" />
        </shape>
    </item>
</layer-list>
