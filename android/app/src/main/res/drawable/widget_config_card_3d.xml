<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Subtle bottom 3D shadow layer -->
    <item>
        <shape>
            <solid android:color="#E2E8F0" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <!-- Main elevated surface with soft golden tint border -->
    <item android:bottom="2.5dp">
        <shape>
            <solid android:color="#FFFFFF" />
            <corners android:radius="18dp" />
            <stroke android:width="1.2dp" android:color="#FDE68A" />
        </shape>
    </item>
</layer-list>
