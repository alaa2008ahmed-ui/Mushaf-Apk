<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Elevation Shadow -->
    <item android:top="2dp" android:left="1dp" android:right="1dp" android:bottom="4dp">
        <shape>
            <solid android:color="#80000000" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <!-- Widget Body -->
    <item android:bottom="2dp">
        <shape>
            <gradient
                android:angle="90"
                android:startColor="#14181F"
                android:endColor="#1C212A" />
            <corners android:radius="20dp" />
            <stroke android:width="1.5dp" android:color="#2E3746" />
        </shape>
    </item>
</layer-list>
