<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layoutDirection="ltr"
    android:background="@drawable/widget_bg_white"
    android:clipToOutline="true"
    android:layout_margin="0dp"
    android:padding="0dp">

    <!-- Top Section (LTR) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="25"
        android:orientation="horizontal"
        android:layoutDirection="ltr"
        android:baselineAligned="false">

        <!-- Left Part: App Icon & Countdown -->
        <RelativeLayout
            android:id="@+id/widget_top_right_section"
            android:layout_width="0dp"
            android:layout_weight="6"
            android:layout_height="match_parent"
            android:layoutDirection="ltr"
            android:background="@drawable/widget_top_right_bg"
            android:padding="0dp">

            <!-- App Icon (Opens Home) -->
            <ImageView
                android:id="@+id/widget_app_icon_small"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@mipmap/ic_launcher"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="10dp"
                android:contentDescription="App Icon" />

            <ImageView
                android:id="@+id/widget_app_icon_large"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@mipmap/ic_launcher"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="10dp"
                android:visibility="gone"
                android:contentDescription="App Icon Large" />

            <!-- Center Countdown Area -->
            <LinearLayout
                android:id="@+id/widget_next_prayer_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layoutDirection="ltr"
                android:layout_centerInParent="true"
                android:gravity="center">

                <TextView
                    android:id="@+id/widget_next_prayer_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fajr in"
                    android:textColor="#FFFFFF"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="6dp" />

                <Chronometer
                    android:id="@+id/widget_next_prayer_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="0dp"
                    android:visibility="gone"
                    android:countDown="true" />

                <TextView
                    android:id="@+id/widget_next_prayer_time_en"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="17.5sp"
                    android:textStyle="bold"
                    android:layout_marginTop="0dp"
                    android:visibility="visible" />
            </LinearLayout>

            <!-- Refresh Button -->
            <ImageView
                android:id="@+id/widget_btn_refresh"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_widget_refresh"
                android:tint="#FFFFFF"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="10dp"
                android:padding="2dp"
                android:contentDescription="Refresh" />
        </RelativeLayout>

        <!-- Right Part: Dates -->
        <LinearLayout
            android:id="@+id/widget_left_section"
            android:layout_width="0dp"
            android:layout_weight="4"
            android:layout_height="match_parent"
            android:background="@drawable/widget_left_bg"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/widget_hijri_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="-- Ramadan 1445"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:gravity="center"
                android:textAlignment="center"
                android:singleLine="true" />

            <TextView
                android:id="@+id/widget_gregorian_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="-- -- --"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:gravity="center"
                android:textAlignment="center"
                android:singleLine="true"
                android:visibility="gone"
                android:layout_marginTop="1dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 4-Color Accent Strip Divider -->
    <LinearLayout
        android:id="@+id/widget_accent_strip"
        android:layout_width="match_parent"
        android:layout_height="2.5dp"
        android:orientation="horizontal"
        android:baselineAligned="false">
        <FrameLayout
            android:id="@+id/full_strip_purple"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:background="#C86400" />
        <FrameLayout
            android:id="@+id/full_strip_green"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:background="#F8DE8A" />
        <FrameLayout
            android:id="@+id/full_strip_teal"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:background="#D97706" />
        <FrameLayout
            android:id="@+id/full_strip_terracotta"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:background="#B45309" />
    </LinearLayout>

    <!-- Middle Section (Prayers LTR) -->
    <LinearLayout
        android:id="@+id/widget_middle_section"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="50"
        android:orientation="horizontal"
        android:layoutDirection="ltr"
        android:background="#FFFFFF"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:clickable="true"
        android:focusable="true">

        <!-- Fajr -->
        <LinearLayout android:id="@+id/col_fajr" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/name_fajr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Fajr" android:textColor="#C86400" android:textSize="12.5sp" android:textStyle="bold" android:singleLine="true" android:includeFontPadding="false"/>
            <TextView android:id="@+id/time_fajr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="04:14" android:textColor="#C86400" android:textSize="14sp" android:textStyle="bold" android:layout_marginTop="0dp" android:singleLine="true" android:includeFontPadding="false"/>
        </LinearLayout>
        <FrameLayout android:id="@+id/sep_1" android:layout_width="1dp" android:layout_height="match_parent" android:background="#E5D07B" android:layout_marginTop="2dp" android:layout_marginBottom="2dp"/>

        <!-- Sunrise -->
        <LinearLayout android:id="@+id/col_sunrise" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/name_sunrise" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sun" android:textColor="#334155" android:textSize="12.5sp" android:textStyle="bold" android:singleLine="true" android:includeFontPadding="false"/>
            <TextView android:id="@+id/time_sunrise" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="05:34" android:textColor="#000000" android:textSize="14sp" android:textStyle="bold" android:layout_marginTop="0dp" android:singleLine="true" android:includeFontPadding="false"/>
        </LinearLayout>
        <FrameLayout android:id="@+id/sep_2" android:layout_width="1dp" android:layout_height="match_parent" android:background="#E5D07B" android:layout_marginTop="2dp" android:layout_marginBottom="2dp"/>

        <!-- Dhuhr -->
        <LinearLayout android:id="@+id/col_dhuhr" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/name_dhuhr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dhuhr" android:textColor="#334155" android:textSize="12.5sp" android:textStyle="bold" android:singleLine="true" android:includeFontPadding="false"/>
            <TextView android:id="@+id/time_dhuhr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="11:45" android:textColor="#000000" android:textSize="14sp" android:textStyle="bold" android:layout_marginTop="0dp" android:singleLine="true" android:includeFontPadding="false"/>
        </LinearLayout>
        <FrameLayout android:id="@+id/sep_3" android:layout_width="1dp" android:layout_height="match_parent" android:background="#E5D07B" android:layout_marginTop="2dp" android:layout_marginBottom="2dp"/>

        <!-- Asr -->
        <LinearLayout android:id="@+id/col_asr" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/name_asr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Asr" android:textColor="#334155" android:textSize="12.5sp" android:textStyle="bold" android:singleLine="true" android:includeFontPadding="false"/>
            <TextView android:id="@+id/time_asr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="03:14" android:textColor="#000000" android:textSize="14sp" android:textStyle="bold" android:layout_marginTop="0dp" android:singleLine="true" android:includeFontPadding="false"/>
        </LinearLayout>
        <FrameLayout android:id="@+id/sep_4" android:layout_width="1dp" android:layout_height="match_parent" android:background="#E5D07B" android:layout_marginTop="2dp" android:layout_marginBottom="2dp"/>

        <!-- Maghrib -->
        <LinearLayout android:id="@+id/col_maghrib" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/name_maghrib" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Magh" android:textColor="#334155" android:textSize="12.5sp" android:textStyle="bold" android:singleLine="true" android:includeFontPadding="false"/>
            <TextView android:id="@+id/time_maghrib" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="05:56" android:textColor="#000000" android:textSize="14sp" android:textStyle="bold" android:layout_marginTop="0dp" android:singleLine="true" android:includeFontPadding="false"/>
        </LinearLayout>
        <FrameLayout android:id="@+id/sep_5" android:layout_width="1dp" android:layout_height="match_parent" android:background="#E5D07B" android:layout_marginTop="2dp" android:layout_marginBottom="2dp"/>

        <!-- Isha -->
        <LinearLayout android:id="@+id/col_isha" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/name_isha" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Isha" android:textColor="#334155" android:textSize="12.5sp" android:textStyle="bold" android:singleLine="true" android:includeFontPadding="false"/>
            <TextView android:id="@+id/time_isha" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="07:26" android:textColor="#000000" android:textSize="14sp" android:textStyle="bold" android:layout_marginTop="0dp" android:singleLine="true" android:includeFontPadding="false"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Section -->
    <LinearLayout
        android:id="@+id/widget_bottom_section"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="25"
        android:orientation="horizontal"
        android:layoutDirection="ltr"
        android:background="@drawable/widget_bottom_bg"
        android:padding="1dp"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/widget_first_third"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="First Third : --:--"
            android:textColor="#000000"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/widget_midnight"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="Midnight : --:--"
            android:textColor="#000000"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/widget_last_third"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="Last Third : --:--"
            android:textColor="#000000"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center" />
    </LinearLayout>
</LinearLayout>
