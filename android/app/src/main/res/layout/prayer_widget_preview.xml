<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="88dp"
    android:orientation="vertical"
    android:layoutDirection="rtl"
    android:background="@drawable/widget_bg_white"
    android:clipToOutline="true"
    android:padding="0dp">

    <!-- Top Section (Header & Date) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="25dp"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- Right Part: Countdown & Icon -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="6.2"
            android:layout_height="match_parent"
            android:background="@drawable/widget_top_right_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:src="@mipmap/ic_launcher"
                android:contentDescription="App Icon" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="الصلاة بعد "
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:includeFontPadding="false" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:24:15"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/ic_widget_refresh"
                android:tint="#FFFFFF"
                android:contentDescription="Refresh" />
        </LinearLayout>

        <!-- Left Part: Hijri Date -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="3.8"
            android:layout_height="match_parent"
            android:background="@drawable/widget_left_bg"
            android:gravity="center"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="١٢ رمضان ١٤٤٥ هـ"
                android:textColor="#FFFFFF"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:gravity="center"
                android:singleLine="true"
                android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>

    <!-- 4-Color Accent Strip Divider -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="2.5dp"
        android:orientation="horizontal"
        android:baselineAligned="false">
        <FrameLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:background="#C86400" />
        <FrameLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:background="#F8DE8A" />
        <FrameLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:background="#D97706" />
        <FrameLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:background="#B45309" />
    </LinearLayout>

    <!-- Middle Section: Prayer Times Grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="41dp"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:gravity="center_vertical">

        <!-- Fajr -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="1dp"
            android:paddingEnd="1dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الفجر"
                android:textColor="#334155"
                android:textSize="10sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:includeFontPadding="false" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="04:14"
                android:textColor="#000000"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:includeFontPadding="false" />
        </LinearLayout>
        <FrameLayout android:layout_width="1dp" android:layout_height="match_parent" android:background="#E5D07B" android:layout_marginTop="3dp" android:layout_marginBottom="3dp"/>

        <!-- Sunrise -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="1dp"
            android:paddingEnd="1dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الشروق"
                android:textColor="#334155"
                android:textSize="10sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:includeFontPadding="false" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="05:34"
                android:textColor="#000000"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:includeFontPadding="false" />
        </LinearLayout>
        <FrameLayout android:layout_width="1dp" android:layout_height="match_parent" android:background="#E5D07B" android:layout_marginTop="3dp" android:layout_marginBottom="3dp"/>

        <!-- Dhuhr -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="1dp"
            android:paddingEnd="1dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الظهر"
                android:textColor="#334155"
                android:textSize="10sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:includeFontPadding="false" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="11:45"
                android:textColor="#000000"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:includeFontPadding="false" />
        </LinearLayout>
        <FrameLayout android:layout_width="1dp" android:layout_height="match_parent" android:background="#E5D07B" android:layout_marginTop="3dp" android:layout_marginBottom="3dp"/>

        <!-- Asr -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="1dp"
            android:paddingEnd="1dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="العصر"
                android:textColor="#334155"
                android:textSize="10sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:includeFontPadding="false" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="03:14"
                android:textColor="#000000"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:includeFontPadding="false" />
        </LinearLayout>
        <FrameLayout android:layout_width="1dp" android:layout_height="match_parent" android:background="#E5D07B" android:layout_marginTop="3dp" android:layout_marginBottom="3dp"/>

        <!-- Maghrib (Highlighted Next Prayer) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="1dp"
            android:paddingEnd="1dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="المغرب"
                android:textColor="#C86400"
                android:textSize="10sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:includeFontPadding="false" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="05:56"
                android:textColor="#C86400"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:includeFontPadding="false" />
        </LinearLayout>
        <FrameLayout android:layout_width="1dp" android:layout_height="match_parent" android:background="#E5D07B" android:layout_marginTop="3dp" android:layout_marginBottom="3dp"/>

        <!-- Isha -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="1dp"
            android:paddingEnd="1dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="العشاء"
                android:textColor="#334155"
                android:textSize="10sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:includeFontPadding="false" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="07:26"
                android:textColor="#000000"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Section: Night Times -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="19.5dp"
        android:orientation="horizontal"
        android:background="@drawable/widget_bottom_bg"
        android:gravity="center">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="أول الليل: 08:30"
            android:textColor="#000000"
            android:textSize="9sp"
            android:textStyle="bold"
            android:gravity="center"
            android:singleLine="true"
            android:includeFontPadding="false" />

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="منتصف الليل: 11:45"
            android:textColor="#000000"
            android:textSize="9sp"
            android:textStyle="bold"
            android:gravity="center"
            android:singleLine="true"
            android:includeFontPadding="false" />

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="الثلث الأخير: 02:15"
            android:textColor="#000000"
            android:textSize="9sp"
            android:textStyle="bold"
            android:gravity="center"
            android:singleLine="true"
            android:includeFontPadding="false" />
    </LinearLayout>
</LinearLayout>
