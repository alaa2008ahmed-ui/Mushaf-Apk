<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="88dp"
    android:orientation="vertical"
    android:layoutDirection="rtl"
    android:background="@drawable/widget_compact_bg"
    android:clipToOutline="true"
    android:padding="6dp">

    <!-- Top Row: App Icon + Date Header + Refresh Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="App Icon" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="١٢ رمضان ١٤٤٥ هـ"
                android:textColor="#000000"
                android:textSize="11sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:includeFontPadding="false" />
        </LinearLayout>

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_widget_refresh"
            android:tint="#C86400"
            android:contentDescription="Refresh" />
    </LinearLayout>

    <!-- Center Row: Previous & Next Prayer Cards -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="3dp">

        <!-- Previous Prayer Card -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_compact_prev_card"
            android:padding="2dp"
            android:layout_marginEnd="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الصلاة السابقة"
                android:textColor="#334155"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الظهر  11:45"
                android:textColor="#000000"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- Next Prayer Card (Elevated Highlight) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1.15"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_compact_next_card"
            android:padding="2dp"
            android:layout_marginStart="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الصلاة القادمة"
                android:textColor="#FEF08A"
                android:textSize="10sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="العصر  03:14"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Ribbon: Remaining Countdown -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/widget_countdown_ribbon"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="متبقي على الأذان:  00:24:15"
            android:textColor="#000000"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />
    </LinearLayout>
</LinearLayout>
