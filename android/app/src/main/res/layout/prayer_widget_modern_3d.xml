<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layoutDirection="rtl"
    android:background="@drawable/widget_3d_card_elevated"
    android:clipToOutline="true"
    android:padding="8dp">

    <!-- Top Floating Header Bar: App Icon + Date Pill + Refresh -->
    <LinearLayout
        android:id="@+id/modern_header_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="4dp">

        <ImageView
            android:id="@+id/widget_app_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="App Icon" />

        <LinearLayout
            android:id="@+id/modern_date_pill"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/modern_hijri_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-- رمضان 1445"
                android:textColor="#059669"
                android:textSize="12sp"
                android:textStyle="bold"
                android:singleLine="true" />

            <TextView
                android:id="@+id/modern_date_sep"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" | "
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/modern_gregorian_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-- -- --"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:textStyle="bold"
                android:singleLine="true" />
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_btn_refresh"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_widget_refresh"
            android:padding="2dp"
            android:contentDescription="Refresh" />
    </LinearLayout>

    <!-- Hero Spotlight 3D Card (Elevated Focus on Upcoming Prayer) -->
    <LinearLayout
        android:id="@+id/modern_hero_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_3d_pod_active"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="6dp">

        <LinearLayout
            android:id="@+id/modern_hero_left"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/modern_hero_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الصلاة القادمة"
                android:textColor="#065F46"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/modern_hero_prayer_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="صلاة العصر"
                android:textColor="#047857"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginTop="1dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/modern_hero_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/modern_hero_prayer_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="03:14"
                android:textColor="#065F46"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="1dp">

                <TextView
                    android:id="@+id/modern_hero_remaining_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="بعد"
                    android:textColor="#059669"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="4dp" />

                <Chronometer
                    android:id="@+id/modern_hero_chronometer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#047857"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:countDown="true" />

                <TextView
                    android:id="@+id/modern_hero_remaining_en"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#047857"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 6 Floating 3D Prayer Pods -->
    <LinearLayout
        android:id="@+id/modern_pods_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- Fajr Pod -->
        <LinearLayout
            android:id="@+id/pod_fajr"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_3d_pod"
            android:padding="3dp"
            android:layout_marginEnd="3dp">
            <TextView android:id="@+id/name_fajr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="الفجر" android:textColor="#475569" android:textSize="12sp" android:textStyle="bold"/>
            <TextView android:id="@+id/time_fajr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="04:14" android:textColor="#1E293B" android:textSize="13.5sp" android:textStyle="bold" android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!-- Sunrise Pod -->
        <LinearLayout
            android:id="@+id/pod_sunrise"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_3d_pod"
            android:padding="3dp"
            android:layout_marginEnd="3dp">
            <TextView android:id="@+id/name_sunrise" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="الشروق" android:textColor="#475569" android:textSize="12sp" android:textStyle="bold"/>
            <TextView android:id="@+id/time_sunrise" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="05:34" android:textColor="#1E293B" android:textSize="13.5sp" android:textStyle="bold" android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!-- Dhuhr Pod -->
        <LinearLayout
            android:id="@+id/pod_dhuhr"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_3d_pod"
            android:padding="3dp"
            android:layout_marginEnd="3dp">
            <TextView android:id="@+id/name_dhuhr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="الظهر" android:textColor="#475569" android:textSize="12sp" android:textStyle="bold"/>
            <TextView android:id="@+id/time_dhuhr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="11:45" android:textColor="#1E293B" android:textSize="13.5sp" android:textStyle="bold" android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!-- Asr Pod -->
        <LinearLayout
            android:id="@+id/pod_asr"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_3d_pod"
            android:padding="3dp"
            android:layout_marginEnd="3dp">
            <TextView android:id="@+id/name_asr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="العصر" android:textColor="#475569" android:textSize="12sp" android:textStyle="bold"/>
            <TextView android:id="@+id/time_asr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="03:14" android:textColor="#1E293B" android:textSize="13.5sp" android:textStyle="bold" android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!-- Maghrib Pod -->
        <LinearLayout
            android:id="@+id/pod_maghrib"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_3d_pod"
            android:padding="3dp"
            android:layout_marginEnd="3dp">
            <TextView android:id="@+id/name_maghrib" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="المغرب" android:textColor="#475569" android:textSize="12sp" android:textStyle="bold"/>
            <TextView android:id="@+id/time_maghrib" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="05:56" android:textColor="#1E293B" android:textSize="13.5sp" android:textStyle="bold" android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!-- Isha Pod -->
        <LinearLayout
            android:id="@+id/pod_isha"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_3d_pod"
            android:padding="3dp">
            <TextView android:id="@+id/name_isha" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="العشاء" android:textColor="#475569" android:textSize="12sp" android:textStyle="bold"/>
            <TextView android:id="@+id/time_isha" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="07:26" android:textColor="#1E293B" android:textSize="13.5sp" android:textStyle="bold" android:layout_marginTop="2dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
